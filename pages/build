#!/usr/bin/env bash
# Build this repository's Pages site into dist/site. This is the only per-repository
# step: pages/finish-site.py, pages/labs-bar.js and .github/workflows/pages.yml are
# the same in every repository with a site.
#
# opensync-lab: the static site in site/ as committed (build-docs.sh regenerates its
# data and viewer from a running lab).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
rm -rf dist/site
mkdir -p dist/site
cp -a site/. dist/site/
test -f dist/site/index.html
echo "Built dist/site: $(find dist/site -type f | wc -l) files from site/"
