#!/usr/bin/env bash
# Build this repository's Pages site into dist/site: the only per-repository step. The rest
# is the labs' shared Pages workflow (easymesh-labs .github/workflows/labs-pages.yml).
#
# opensync-lab: the static site in site/ as committed (build-docs.sh regenerates its
# data and viewer from a running lab).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
rm -rf dist/site
mkdir -p dist/site
cp -a site/. dist/site/
test -f dist/site/index.html
echo "Built dist/site: $(find dist/site -type f | wc -l) files from site/"
