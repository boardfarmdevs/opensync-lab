+/* A channel switch hostapd refuses (e.g. an MT7921U AP that
+ * shares its radio with a station) was retried at every
+ * confsync attempt: the AP never left its channel, confsync
+ * never settled and its watchdog aborted owm. Remember the
+ * refusal so that the next attempt restarts the BSS on the new
+ * channel instead (osw_hostap_csa.h).
+ */
+static void
+osw_hostap_bss_hapd_csa_done_cb(struct rq_task *task,
+                                void *priv)
+{
+    struct osw_hostap_bss_hapd *hapd = priv;
+    struct hostap_rq_task *t = container_of(task, struct hostap_rq_task, task);
+
+    osw_hostap_bss_cmd_warn_on_err(task, priv);
+    if (osw_hostap_csa_refused(t->reply)) {
+        LOGN(LOG_PREFIX_HAPD(hapd, "csa: refused by hostapd, restarting the bss on the new channel next"));
+        hapd->csa_failed = true;
+    }
+}
