diff --git a/src/lib/ow/src/ow_sta_channel_override_action.h b/src/lib/ow/src/ow_sta_channel_override_action.h
new file mode 100644
index 00000000..08312d49
--- /dev/null
+++ b/src/lib/ow/src/ow_sta_channel_override_action.h
@@ -0,0 +1,31 @@
+/*
+ * ow: which channel the STA channel override gives an AP (opensync-lab / opensync-rpi).
+ *
+ * With a station linked on the radio, an AP takes the station's channel; while its own
+ * channel recently changed it keeps that (settling). An AP that is not running took no
+ * override and so started on its configured channel; a restart meant to move it to the
+ * station's channel (core patch 0008, an AP whose CSA is refused) brought it back there,
+ * once a minute. It now starts on the station's channel. Kept free of the module's state
+ * so that pod/opensync/tests/ow_sta_channel_override_action_test.c tests it on its own.
+ */
+#ifndef OW_STA_CHANNEL_OVERRIDE_ACTION_H_INCLUDED
+#define OW_STA_CHANNEL_OVERRIDE_ACTION_H_INCLUDED
+
+#include <stdbool.h>
+
+enum ow_sta_channel_override_action {
+    OW_STA_CHANNEL_OVERRIDE_DONT_CHANGE,
+    OW_STA_CHANNEL_OVERRIDE_USE_AP_STATE_CHAN,
+    OW_STA_CHANNEL_OVERRIDE_USE_STA_STATE_CHAN,
+};
+
+static inline enum ow_sta_channel_override_action
+ow_sta_channel_override_action_for(bool sta_linked, bool ap_running, bool ap_settling)
+{
+    if (!sta_linked) return OW_STA_CHANNEL_OVERRIDE_DONT_CHANGE;
+    if (!ap_running) return OW_STA_CHANNEL_OVERRIDE_USE_STA_STATE_CHAN;
+    if (ap_settling) return OW_STA_CHANNEL_OVERRIDE_USE_AP_STATE_CHAN;
+    return OW_STA_CHANNEL_OVERRIDE_USE_STA_STATE_CHAN;
+}
+
+#endif /* OW_STA_CHANNEL_OVERRIDE_ACTION_H_INCLUDED */
