diff --git a/src/cm2/src/cm2_stability_count.h b/src/cm2/src/cm2_stability_count.h
new file mode 100644
index 00000000..e9f84339
--- /dev/null
+++ b/src/cm2/src/cm2_stability_count.h
@@ -0,0 +1,90 @@
+/*
+ * cm2: counting an uplink's router-check failures (opensync-lab / opensync-rpi).
+ *
+ * cm2 restarts OpenSync once an uplink's router check has failed more than
+ * CONFIG_CM2_STABILITY_THRESH_FATAL times in a row: at the short stability interval
+ * about 80 s without the router. Besides the periodic check, every uplink table change
+ * requests a check, and during a link change those ran back to back (one per 2 s ping
+ * timeout), reaching the threshold in 15 s. So a failure counts once per interval per
+ * uplink; checks in between keep the count (and do not repeat its restore actions).
+ * Kept free of cm2's other state, with the time passed in, so that it can be tested
+ * on its own.
+ */
+#ifndef CM2_STABILITY_COUNT_H_INCLUDED
+#define CM2_STABILITY_COUNT_H_INCLUDED
+
+#include <stdbool.h>
+#include <string.h>
+#include <time.h>
+
+#define CM2_STABILITY_COUNT_UPLINKS 8
+
+struct cm2_stability_count
+{
+    struct
+    {
+        char if_name[64];
+        bool used;
+        time_t last; /* when its last failure was counted */
+    } uplinks[CM2_STABILITY_COUNT_UPLINKS];
+};
+
+/* Whether a failure of if_name at now counts (and if so, now becomes its last). */
+static inline bool cm2_stability_count_due(struct cm2_stability_count *sc,
+                                           const char *if_name,
+                                           time_t now,
+                                           int interval)
+{
+    const size_t n = CM2_STABILITY_COUNT_UPLINKS;
+    size_t i;
+    size_t slot = 0;
+
+    for (i = 0; i < n; i++)
+    {
+        if (sc->uplinks[i].used && strcmp(sc->uplinks[i].if_name, if_name) == 0) break;
+        if (!sc->uplinks[i].used) slot = i;
+        else if (sc->uplinks[slot].used && sc->uplinks[i].last < sc->uplinks[slot].last) slot = i;
+    }
+    if (i == n)
+    {
+        /* not seen yet: a free slot, else the one counted longest ago */
+        i = slot;
+        memset(&sc->uplinks[i], 0, sizeof(sc->uplinks[i]));
+        strncpy(sc->uplinks[i].if_name, if_name, sizeof(sc->uplinks[i].if_name) - 1);
+    }
+    else if (now - sc->uplinks[i].last < interval)
+    {
+        return false;
+    }
+    sc->uplinks[i].used = true;
+    sc->uplinks[i].last = now;
+    return true;
+}
+
+/*
+ * The router failure counter after a check of if_name at now: 0 after a success; after
+ * a failure, one more than prev when it counts (*counted), else prev unchanged. prev is
+ * the stored counter (Connection_Manager_Uplink.unreachable_router_counter, -1 unset).
+ */
+static inline int cm2_stability_count_router(struct cm2_stability_count *sc,
+                                             const char *if_name,
+                                             int prev,
+                                             bool failed,
+                                             time_t now,
+                                             int interval,
+                                             bool *counted)
+{
+    *counted = false;
+    if (!failed) return 0;
+    if (prev <= 0)
+    {
+        (void)cm2_stability_count_due(sc, if_name, now, interval);
+        *counted = true;
+        return 1;
+    }
+    if (!cm2_stability_count_due(sc, if_name, now, interval)) return prev;
+    *counted = true;
+    return prev + 1;
+}
+
+#endif /* CM2_STABILITY_COUNT_H_INCLUDED */
