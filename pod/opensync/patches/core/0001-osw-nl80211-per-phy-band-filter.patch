                                 &state->n_channel_states,
                                 tb[NL80211_ATTR_WIPHY_BANDS]);
+    osw_drv_nl80211_phy_band_filter(info->name,
+                                    state->channel_states,
+                                    &state->n_channel_states);
 }
 
