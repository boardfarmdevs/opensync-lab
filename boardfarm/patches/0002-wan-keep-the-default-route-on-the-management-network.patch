From a648eabe5bf82d20e3ec9b5c9bde58b04f8476a0 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <revogelaar@gmail.com>
Date: Tue, 22 Sep 2026 19:25:45 -0700
Subject: [PATCH] wan: keep the default route on the management network

bf-lab attaches the CPE-facing network (eth1, enable_ip_masquerade=false) with
'docker network connect' after the wan init has started. docker >= 28
re-selects the container's default gateway on every network connect, so eth1
can become the default route; the init's 'ip route add default' then fails
with 'File exists' and neither the wan container nor any CPE behind it
reaches the internet. Replace the route, and keep it pinned against later
reconnects. Seen with docker 29.1.3 in a fresh LXD VM.
---
 resources/wan/init | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/resources/wan/init b/resources/wan/init
index 5696b37..d2bd370 100644
--- a/resources/wan/init
+++ b/resources/wan/init
@@ -188,7 +188,20 @@ if [ "$ENABLE_NAT" == "yes" ]; then
     # The gateway is typically .1 on the management subnet
     MGMT_GATEWAY="${NAT_GATEWAY:-10.22.0.1}"
     echo "Adding default route via $MGMT_GATEWAY"
-    ip route add default via $MGMT_GATEWAY dev $INTERNET_IFACE
+    #
+    # 'replace', not 'add', and keep it pinned: bf-lab attaches the CPE-facing
+    # network (eth1, not masqueraded) with 'docker network connect' after this
+    # init has started, and docker >= 28 re-selects the container's default
+    # gateway on every network connect -- so eth1 can end up as the default and
+    # 'add' then fails silently with "File exists", leaving the CPEs without
+    # internet. Seen with docker 29.1.3 in a fresh VM.
+    ip route replace default via $MGMT_GATEWAY dev $INTERNET_IFACE
+    (
+        while sleep 5; do
+            ip route show default | grep -q "via $MGMT_GATEWAY dev $INTERNET_IFACE" \
+                || ip route replace default via $MGMT_GATEWAY dev $INTERNET_IFACE
+        done
+    ) &
 
     # Enable masquerading (SNAT) for traffic from eth1 going to eth0
     iptables -t nat -A POSTROUTING -o $INTERNET_IFACE -j MASQUERADE
-- 
2.34.1

