+/* opensync-lab: only an ISO 3166 alpha-2 code (two letters) is a country.
+ * cfg80211 reports special domains with digits: "00" (world), "98"
+ * (intersected), "99" (a driver's custom domain, e.g. mac80211_hwsim's). hostapd
+ * rejects them as country_code, so no BSS starts; with ieee80211d it would also
+ * try to set the host's regulatory domain from them. */
+static bool
+osw_hostap_conf_is_country(const char *ccode)
+{
+    return strlen(ccode) == 2
+        && ccode[0] >= 'A' && ccode[0] <= 'Z'
+        && ccode[1] >= 'A' && ccode[1] <= 'Z';
+}
+
