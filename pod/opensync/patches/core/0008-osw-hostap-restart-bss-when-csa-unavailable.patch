diff --git a/src/lib/osw/src/osw_hostap_csa.h b/src/lib/osw/src/osw_hostap_csa.h
new file mode 100644
index 00000000..3c742e0e
--- /dev/null
+++ b/src/lib/osw/src/osw_hostap_csa.h
@@ -0,0 +1,41 @@
+/*
+ * osw hostap: how an AP's channel change is applied (opensync-lab / opensync-rpi).
+ *
+ * A channel change confsync marks CSA-eligible was applied only as hostapd's
+ * CHAN_SWITCH, and only on phys configured for it; a refused CHAN_SWITCH went
+ * unnoticed. Now: CSA when the phy has it and hostapd did not refuse the last one,
+ * else the BSS is restarted on the new channel. Kept free of osw_hostap's state, so
+ * that it can be tested on its own (pod/opensync/tests/osw_hostap_csa_test.c).
+ */
+#ifndef OSW_HOSTAP_CSA_H_INCLUDED
+#define OSW_HOSTAP_CSA_H_INCLUDED
+
+#include <stdbool.h>
+#include <string.h>
+
+struct osw_hostap_csa_plan
+{
+    bool csa;     /* switch the running BSS with CHAN_SWITCH */
+    bool restart; /* remove the BSS and add it on the new channel */
+};
+
+static inline struct osw_hostap_csa_plan
+osw_hostap_csa_plan(bool channel_changed, bool csa_required, bool csa_by_hostap, bool csa_failed)
+{
+    struct osw_hostap_csa_plan plan = { false, false };
+
+    if (!channel_changed) return plan;
+    if (csa_required && csa_by_hostap && !csa_failed)
+        plan.csa = true;
+    else
+        plan.restart = true;
+    return plan;
+}
+
+/* Whether hostapd's reply to CHAN_SWITCH refuses it. */
+static inline bool osw_hostap_csa_refused(const char *reply)
+{
+    return reply != NULL && strncmp(reply, "FAIL", 4) == 0;
+}
+
+#endif /* OSW_HOSTAP_CSA_H_INCLUDED */
