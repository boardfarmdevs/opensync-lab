     if ((g_state.link.ipv4.resolve_retry && ipv6 && addr->ipv6_addr_list.state == CM2_ARES_R_RESOLVED) ||
         (g_state.link.ipv6.resolve_retry && ipv4 && addr->ipv4_addr_list.state == CM2_ARES_R_RESOLVED))
diff --git a/src/cm2/src/cm2_resolve_family.h b/src/cm2/src/cm2_resolve_family.h
new file mode 100644
index 00000000..982a63d3
--- /dev/null
+++ b/src/cm2/src/cm2_resolve_family.h
@@ -0,0 +1,49 @@
+/*
+ * cm2: the address families cm2_resolve() asks c-ares for (opensync-lab / opensync-rpi).
+ *
+ * cm2_resolve() asks for both families when the uplink has both, and TRY_RESOLVE waits
+ * until neither query is in progress. c-ares answers an address literal at once only in
+ * its own family: asked for 10.0.0.1 as AF_INET6, it sends the name to DNS, so where DNS
+ * does not answer, the IPv4 result (there at once) waited out TRY_RESOLVE's 180 s. So
+ * an address literal is asked for in its own family only, and never goes to DNS; a
+ * name is asked for as before. Kept free of cm2's other state so that it can be tested
+ * on its own.
+ */
+#ifndef CM2_RESOLVE_FAMILY_H_INCLUDED
+#define CM2_RESOLVE_FAMILY_H_INCLUDED
+
+#include <arpa/inet.h>
+#include <stdbool.h>
+#include <sys/socket.h>
+
+/* AF_INET or AF_INET6 for an address literal, else AF_UNSPEC (a name to resolve). */
+static inline int cm2_resolve_literal_family(const char *hostname)
+{
+    struct in6_addr in6;
+    struct in_addr in4;
+
+    if (inet_pton(AF_INET, hostname, &in4) == 1) return AF_INET;
+    if (inet_pton(AF_INET6, hostname, &in6) == 1) return AF_INET6;
+    return AF_UNSPEC;
+}
+
+/*
+ * The families to ask for: *ipv4 and *ipv6 come in as the ones the uplink can use, and
+ * an address literal keeps only its own (none, when the uplink lacks it).
+ */
+static inline void cm2_resolve_families(const char *hostname, bool *ipv4, bool *ipv6)
+{
+    switch (cm2_resolve_literal_family(hostname))
+    {
+        case AF_INET:
+            *ipv6 = false;
+            break;
+        case AF_INET6:
+            *ipv4 = false;
+            break;
+        default:
+            break;
+    }
+}
+
+#endif /* CM2_RESOLVE_FAMILY_H_INCLUDED */
